[server]
hosts = 0.0.0.0:5232
max_connections = 20
timeout = 30

[auth]
type = htpasswd
htpasswd_filename = /data/radicale/users
htpasswd_encryption = bcrypt
delay = 1

[rights]
type = owner_only

[storage]
filesystem_folder = /data/radicale/collections

[logging]
level = info
mask_passwords = true
