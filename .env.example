APP_USERNAME=operator
APP_PASSWORD=replace-with-a-long-random-secret
AUTH_MODE=basic
# Keyverse OIDC is intentionally opt-in. Set AUTH_MODE=oidc only after the
# exact issuer, audience, JWKS, organization, and workspace contract is ready.
OIDC_ISSUER=
OIDC_AUDIENCE=saju-caldav-web
OIDC_JWKS_URL=
OIDC_REQUIRED_ORG=org-cwl
OIDC_REQUIRED_WORKSPACE=workspace-org-cwl
OIDC_ALLOWED_ROLES=member
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_JWKS_CACHE_SECONDS=300
CALDAV_USERNAME=caluser
CALDAV_PASSWORD=replace-with-a-different-long-random-secret
WEB_BIND=0.0.0.0
WEB_PORT=8000
CALDAV_BIND=0.0.0.0
CALDAV_PORT=5232
